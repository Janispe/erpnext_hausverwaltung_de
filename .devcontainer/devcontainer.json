// Devcontainer für die App `hausverwaltung`.
//
// Eigenständig: Voraussetzung ist nur dieses Repo plus Docker. Die beiden
// required_apps (process_engine, mail_merge) holt setup.sh beim ersten Start
// von GitHub. Nachbar-Clones oder eine bestehende Bench-Umgebung braucht es
// nicht.
//
// Die private App `hausverwaltung_peters` ist hier weder gemountet noch
// installiert — in diesem Container können keine Mandantendaten liegen.
{
	"name": "hausverwaltung",

	"dockerComposeFile": "docker-compose.yml",
	"service": "frappe",
	"workspaceFolder": "/home/frappe/frappe-bench/apps/hausverwaltung",
	"remoteUser": "frappe",
	"shutdownAction": "stopCompose",

	// Erster Start: Apps holen und Site anlegen, 10-20 Minuten.
	// Jeder weitere Start überspringt beides.
	"postCreateCommand": "bash .devcontainer/setup.sh",

	// 8200 = bench start, 9200 = socketio. Beide bereits in der compose auf
	// 127.0.0.1 veröffentlicht.
	"forwardPorts": [8200, 9200],

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"charliermarsh.ruff",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				"remote.autoForwardPorts": false,
				"python.defaultInterpreterPath": "/home/frappe/frappe-bench/env/bin/python",

				// Tabs, nicht Spaces — auch in Python.
				// Siehe pyproject.toml, [tool.ruff.format] indent-style = "tab".
				"editor.insertSpaces": false,
				"editor.detectIndentation": false,
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff",
					"editor.insertSpaces": false
				},

				"files.watcherExclude": {
					"**/node_modules/**": true,
					"**/__pycache__/**": true,
					"**/.git/objects/**": true
				}
			}
		}
	}
}
